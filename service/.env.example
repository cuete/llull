# ============================================================
# Llull Service — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Auth ---
# Set to false for local dev (uses hardcoded test user)
AUTH_ENABLED=false
# AAD tenant and client IDs (required when AUTH_ENABLED=true)
AAD_TENANT_ID=your-tenant-id
AAD_CLIENT_ID=your-client-id

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/llull.db

# --- LLM Provider ---
# Options: openai, anthropic, ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
LLM_API_KEY=your-api-key-here
# For Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
# For Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01

# --- Storage ---
# Options: azure, local
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads
# Azure Blob (required when STORAGE_BACKEND=azure)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=llull-sources

# --- Embeddings ---
EMBEDDING_MODEL=all-mpnet-base-v2

# --- App ---
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
